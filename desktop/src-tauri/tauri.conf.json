{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bantou",
  "version": "../package.json",
  "identifier": "jp.grrow.bantou",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:sidecar && bun run generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/bantou-center",
      "binaries/bantou-pty-wrapper"
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/unagents/bantou/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0OUQ2OTU5QTMyMjg1RjQKUldUMGhTS2pXV21kUk8wZHJ2bkNwMWxxMVlNMWN6N2xaa0JYM2tFWnUzdVU3djBLdXFYb1AwOWYK"
    }
  }
}
