{
  "name": "@agent-hand/bantou-center",
  "version": "0.1.0",
  "description": "bantou center: MCP server that supervises claude remote-control per project and relays commands to bantou-server",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "bantou-center": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:bin": "bun scripts/build-bin.ts",
    "dev": "node --import tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "node --import tsx scripts/e2e.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@agent-hand/bantou-protocol": "file:../protocol",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@unagents/messenger-client": "0.10.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
