<?xml version="1.0" encoding="UTF-8"?>
<!-- bantou server の launchd LaunchDaemon 雛形（scripts/install-service.sh が @...@ を埋めて /Library/LaunchDaemons に置く） -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.unagents.bantou</string>
  <key>UserName</key><string>@USER@</string>
  <key>WorkingDirectory</key><string>@HOME@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@NPX@</string>
    <string>-y</string>
    <string>bantou@@VERSION@</string>
    <string>--config</string>
    <string>@HOME@/config.json</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>@HOME@</string>
    <key>BANTOU_HOME</key><string>@HOME@</string>
    <key>CLAUDE_CONFIG_DIR</key><string>@HOME@/.claude</string>
    <key>GIT_CONFIG_GLOBAL</key><string>@HOME@/.config/git/gitconfig</string>
    <key>PATH</key><string>@HOME@/.local/bin:@HOME@/.bun/bin:@NODE_BIN@:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>@HOME@/server.log</string>
  <key>StandardErrorPath</key><string>@HOME@/server.log</string>
</dict>
</plist>
