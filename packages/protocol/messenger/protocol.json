{
  "name": "bantou",
  "version": "2.0.0",
  "description": "bantou protocol v2. center to server: launch, stop (callType invoke), answer, approve, reject (callType reply), server-info (callType status). server to the sender of server-info: server-info with the version. Message body is one JSON object in the text; `protocol: \"bantou\"` marks it. callType `exec` is accepted as a callType but has no defined order (ignored).",
  "messages": {
    "launch": {
      "type": "object",
      "description": "center to server. Start a worker for the cap `parent-id`.",
      "required": ["protocol", "callType", "order", "parent-id", "prompt", "ws"],
      "properties": {
        "protocol": { "const": "bantou" },
        "callType": { "const": "invoke" },
        "order": { "const": "launch" },
        "parent-id": { "type": "string", "minLength": 1, "description": "Name of the cap." },
        "model": { "type": "string", "pattern": "^[A-Za-z0-9._\\[\\]][A-Za-z0-9._\\[\\]-]*$", "description": "Model of the worker. Optional; when absent the server does not pass --model." },
        "prompt": { "type": "string", "minLength": 1, "description": "The work to do." },
        "ws": { "type": "string", "minLength": 1, "description": "Destination of the center's ws." },
        "schema": {
          "type": "object",
          "description": "Optional. Where the center's schema server (/mcp/schemas) is. The JSON object that goes as-is in the x-schema-discovery header of openspec-mcp.",
          "required": ["type", "url", "headers"],
          "properties": {
            "type": { "const": "http" },
            "url": { "type": "string", "minLength": 1, "description": "URL of the center's /mcp/schemas." },
            "headers": {
              "type": "object",
              "required": ["Authorization"],
              "properties": { "Authorization": { "type": "string", "minLength": 1 } },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "stop": {
      "type": "object",
      "description": "center to server. Stop the workers of the cap `parent-id`.",
      "required": ["protocol", "callType", "order", "parent-id"],
      "properties": {
        "protocol": { "const": "bantou" },
        "callType": { "const": "invoke" },
        "order": { "const": "stop" },
        "parent-id": { "type": "string", "minLength": 1, "description": "Name of the cap." }
      },
      "additionalProperties": true
    },
    "answer": {
      "type": "object",
      "description": "center to server. The answer to a worker's question.",
      "required": ["protocol", "callType", "order", "session-id", "content"],
      "properties": {
        "protocol": { "const": "bantou" },
        "callType": { "const": "reply" },
        "order": { "const": "answer" },
        "session-id": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "description": "The answer text." }
      },
      "additionalProperties": true
    },
    "approve": {
      "type": "object",
      "description": "center to server. Approve what the worker asked to do.",
      "required": ["protocol", "callType", "order", "session-id"],
      "properties": {
        "protocol": { "const": "bantou" },
        "callType": { "const": "reply" },
        "order": { "const": "approve" },
        "session-id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "reject": {
      "type": "object",
      "description": "center to server. Reject what the worker asked to do.",
      "required": ["protocol", "callType", "order", "session-id"],
      "properties": {
        "protocol": { "const": "bantou" },
        "callType": { "const": "reply" },
        "order": { "const": "reject" },
        "session-id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "server-info": {
      "type": "object",
      "description": "center to server. Ask for the server's version. The server answers with server-info_reply.",
      "required": ["protocol", "callType", "order"],
      "properties": {
        "protocol": { "const": "bantou" },
        "callType": { "const": "status" },
        "order": { "const": "server-info" }
      },
      "additionalProperties": true
    },
    "server-info_reply": {
      "type": "object",
      "description": "server to the sender of server-info. Same callType and order as server-info, plus `version`.",
      "required": ["protocol", "callType", "order", "version"],
      "properties": {
        "protocol": { "const": "bantou" },
        "callType": { "const": "status" },
        "order": { "const": "server-info" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "npm `bantou` version of the running server." }
      },
      "additionalProperties": true
    }
  }
}
