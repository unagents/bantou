{
  "name": "bantou",
  "version": "1.2.0",
  "description": "bantou-server commands (kick_cap, stop_cap, status), replies (cap_result, stop_result, status_result, error) and a notice (activity). Message body is one JSON object in the text; `bantou: 1` is the body schema version.",
  "messages": {
    "kick_cap": {
      "type": "object",
      "description": "Start or resume the remote cap `cap_id` headlessly with `prompt`. Reply: cap_result or error.",
      "required": ["bantou", "type", "cap_id", "prompt"],
      "properties": {
        "bantou": { "const": 1 },
        "type": { "const": "kick_cap" },
        "cap_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "repo": { "type": "string", "minLength": 1, "description": "Git URL; cloned into the cap path on first use, fetched afterwards. Must not start with '-'." },
        "branch": { "type": "string", "minLength": 1, "description": "Branch for git clone --branch. Must not start with '-'." },
        "prompt": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "description": "Free text, logged only." }
      },
      "additionalProperties": true
    },
    "stop_cap": {
      "type": "object",
      "description": "Stop the running remote cap `cap_id` (kills its claude process group). Reply: stop_result or error. The interrupted kick_cap still gets its own cap_result with ok=false.",
      "required": ["bantou", "type", "cap_id"],
      "properties": {
        "bantou": { "const": 1 },
        "type": { "const": "stop_cap" },
        "cap_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
      },
      "additionalProperties": true
    },
    "stop_result": {
      "type": "object",
      "required": ["bantou", "type", "ok", "cap_id", "stopped"],
      "properties": {
        "bantou": { "const": 1 },
        "type": { "const": "stop_result" },
        "ok": { "const": true },
        "cap_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "stopped": { "type": "boolean", "description": "true when a running (or about to start) run was stopped; false when the cap was not running." }
      },
      "additionalProperties": true
    },
    "status": {
      "type": "object",
      "description": "List caps and workers with their state. Reply: status_result.",
      "required": ["bantou", "type"],
      "properties": {
        "bantou": { "const": 1 },
        "type": { "const": "status" }
      },
      "additionalProperties": true
    },
    "cap_result": {
      "type": "object",
      "description": "Outcome of one headless cap run (also sent when a worker report resumes the cap).",
      "required": ["bantou", "type", "cap_id", "session_id", "ok", "result_text"],
      "properties": {
        "bantou": { "const": 1 },
        "type": { "const": "cap_result" },
        "cap_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "session_id": { "type": "string", "description": "Claude session id used (new or resumed)." },
        "ok": { "type": "boolean" },
        "result_text": { "type": "string", "description": "Final result text; empty when the run failed before producing one." },
        "error": { "type": "string", "description": "Failure detail when ok is false." }
      },
      "additionalProperties": true
    },
    "status_result": {
      "type": "object",
      "required": ["bantou", "type", "ok", "caps", "workers"],
      "properties": {
        "bantou": { "const": 1 },
        "type": { "const": "status_result" },
        "ok": { "const": true },
        "caps": { "type": "array", "items": { "$ref": "#/$defs/agent_status" } },
        "workers": { "type": "array", "items": { "$ref": "#/$defs/agent_status" } }
      },
      "$defs": {
        "agent_status": {
          "type": "object",
          "required": ["kind", "id", "path", "session_id", "state", "last_started_at", "last_finished_at", "retries", "queued"],
          "properties": {
            "kind": { "enum": ["cap", "worker"] },
            "id": { "type": "string" },
            "path": { "type": "string", "description": "Absolute directory." },
            "session_id": { "type": ["string", "null"] },
            "state": { "enum": ["idle", "running", "failed", "error"] },
            "last_started_at": { "type": ["string", "null"], "description": "ISO 8601." },
            "last_finished_at": { "type": ["string", "null"], "description": "ISO 8601." },
            "last_error": { "type": "string" },
            "retries": { "type": "number" },
            "queued": { "type": "number", "description": "Commands waiting in this agent's queue (the running one excluded)." }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "activity": {
      "type": "object",
      "description": "Notice from server to center (not a reply). Liveness summary of a cap and its workers, derived from their stream-json output. Sent every 5s while any agent runs, and on each state change.",
      "required": ["bantou", "type", "cap_id", "at", "agents"],
      "properties": {
        "bantou": { "const": 1 },
        "type": { "const": "activity" },
        "cap_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "at": { "type": "string", "description": "Send time (server clock, ISO 8601)." },
        "agents": { "type": "array", "description": "The cap first, then its workers by id.", "items": { "$ref": "#/$defs/agent_activity" } }
      },
      "$defs": {
        "agent_activity": {
          "type": "object",
          "required": ["kind", "id", "cap_id", "state", "task", "last_activity", "last_output_at", "silent_ms", "started_at", "finished_at"],
          "properties": {
            "kind": { "enum": ["cap", "worker"] },
            "id": { "type": "string" },
            "cap_id": { "type": "string", "description": "The cap itself for a cap, the owning cap for a worker." },
            "state": { "enum": ["running", "stalled", "idle", "done", "failed", "lost"] },
            "task": { "type": "string", "description": "Head of the last kick_cap / worker_start prompt (one line, at most 200 chars)." },
            "last_activity": { "type": ["string", "null"], "description": "Short summary of the latest activity (at most 120 chars)." },
            "last_output_at": { "type": ["string", "null"], "description": "When the last stdout line arrived (server clock, ISO 8601)." },
            "silent_ms": { "type": "number", "description": "Milliseconds since the last output (or started_at) at send time." },
            "started_at": { "type": ["string", "null"] },
            "finished_at": { "type": ["string", "null"] },
            "error": { "type": "string", "description": "Why the agent is failed / lost (at most 200 chars)." }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": ["bantou", "type", "ok", "message"],
      "properties": {
        "bantou": { "const": 1 },
        "type": { "const": "error" },
        "ok": { "const": false },
        "message": { "type": "string" },
        "command": { "enum": ["kick_cap", "resume_worker", "stop_cap", "status"], "description": "type of the failed command, when known." },
        "cap_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "worker_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
      },
      "additionalProperties": true
    }
  }
}
