# ~/.config/bantou-memory/env にコピーして値を埋める（chmod 600）
MEMORY_PORT=7930
# bantou の「外部記憶」設定の token と同じ値
MEMORY_TOKEN=
# 接続は非 superuser role（RLS が効く）。README の「DB role」参照
MEMORY_DATABASE_URL=postgres://memory_app:PASSWORD@127.0.0.1:5433/memory
OLLAMA_URL=http://127.0.0.1:11435
MEMORY_EMBED_MODEL=nomic-embed-text
MEMORY_EMBED_DIM=768
# 抽出 LLM（unagents/chatp。OpenAI 互換）
CHATP_URL=
CHATP_TOKEN=
