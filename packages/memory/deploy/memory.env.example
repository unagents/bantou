# ~/.config/bantou-memory/env にコピーして値を埋める（chmod 600）
MEMORY_PORT=7930
# bantou の「外部記憶」設定の token と同じ値
MEMORY_TOKEN=
# 接続は非 superuser role（RLS が効く）。README の「DB role」参照
MEMORY_DATABASE_URL=postgres://memory_app:PASSWORD@127.0.0.1:5433/memory
# 認証情報（user:pass@）を入れない
OLLAMA_URL=http://127.0.0.1:11435
MEMORY_EMBED_MODEL=nomic-embed-text
MEMORY_EMBED_DIM=768
# 抽出 LLM（unagents/chatp。OpenAI 互換）
CHATP_URL=
CHATP_TOKEN=
# Graphiti（公式 MCP server）への反映。空なら Outbox を消費しない（今まで通り積むだけ）。docs/design/memory-graphiti.md
#GRAPHITI_MCP_URL=http://127.0.0.1:7931/mcp/
# 反映する Outbox の topic（カンマ区切り。既定は graphiti.memory_item のみ。未決 2 の暫定）
#GRAPHITI_TOPICS=graphiti.memory_item
#GRAPHITI_TIMEOUT_MS=30000
# 以下 4 つは暫定値（利用者が決めていない。docs/design/memory-graphiti.md の未決 3・6・7・9）
#GRAPHITI_IN_FLIGHT=20
#GRAPHITI_MAX_ATTEMPTS=5
#GRAPHITI_CONFIRM_TIMEOUT_MIN=30
#GRAPHITI_BODY_MAX=4000
# 埋め込みの消化（既定のままでよい。README「埋め込みの消化」）
# 1 回に送る件数。recall の query が待つ最長時間はこの 1 回分
#MEMORY_EMBED_BATCH=1
# 1 回の run の時間上限。55000 で頭打ち（run が 60 秒を越えると毎分の起動が飛ぶため）
#MEMORY_EMBED_RUN_MS=50000
# 1 回の /api/embed の timeout。1 件がこれに収まらない機械では延ばす
#MEMORY_EMBED_TIMEOUT_MS=60000
#MEMORY_RECALL_EMBED_TIMEOUT_MS=60000
# chatp の timeout（無ければ MEMORY_HTTP_TIMEOUT_MS、それも無ければ 120000）
#CHATP_TIMEOUT_MS=120000
