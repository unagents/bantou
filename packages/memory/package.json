{
  "name": "@unagents/bantou-memory",
  "version": "0.0.0",
  "private": true,
  "description": "bantou external memory (MCP server)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "migrate": "node-pg-migrate -m migrations --migrations-table pgmigrations",
