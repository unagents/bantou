{
  "name": "bantou",
  "version": "0.1.1",
  "description": "Remote session and remote cap launcher server for bantou-desktop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unagents/bantou.git",
    "directory": "server"
  },
  "type": "module",
  "bin": {
    "bantou": "bin/bantou.mjs"
  },
  "files": [
    "bin",
    ".output"
  ],
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt build && node bin/bantou.mjs",
    "e2e": "nuxt build && node --import tsx scripts/e2e-launch.ts",
    "prepack": "nuxt build",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "nuxt prepare && tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@agent-hand/bantou-protocol": "file:../packages/protocol",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.0.0",
    "@unagents/messenger-broker": "0.9.0",
    "@unagents/messenger-client": "0.9.0",
    "nuxt": "~4.5.2",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "zod": "^4.6.7"
  }
}
