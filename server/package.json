{
  "name": "bantou",
  "version": "0.1.1",
  "description": "Remote session and remote cap launcher server for bantou-desktop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unagents/bantou.git",
    "directory": "server"
  },
  "type": "module",
  "bin": {
    "bantou": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
