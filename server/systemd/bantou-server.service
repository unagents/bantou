# systemd user unit template for bantou-server (not installed by any script).
# Copy to ~/.config/systemd/user/ and adjust ExecStart to the real binary path.
[Unit]
Description=bantou-server

[Service]
Type=simple
ExecStart=%h/.cargo/bin/bantou-server --config %h/.config/bantou-server/config.toml
Restart=on-failure

[Install]
WantedBy=default.target
